<mxfile host="app.diagrams.net">
  <diagram name="Trajectory Evaluation" id="traj-eval">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Trajectory Evaluation: Capture → Score → Decide" style="text;html=1;fontSize=15;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Agent -->
        <mxCell id="agent" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;receives query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Tool calls -->
        <mxCell id="t1" value="search_flights" style="rounded=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="get_weather" style="rounded=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="110" height="30" as="geometry" />
        </mxCell>

        <!-- Hook captures -->
        <mxCell id="hook" value="&lt;b&gt;TrajectoryPlugin&lt;/b&gt;&lt;br&gt;(HookProvider)&lt;br&gt;captures every call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Trajectory data -->
        <mxCell id="traj" value="&lt;b&gt;Trajectory&lt;/b&gt;&lt;br&gt;[search_flights, get_weather]&lt;br&gt;+ timing, status, params" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="60" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Three evaluation paths -->
        <mxCell id="eval1" value="&lt;b&gt;ToolCalled&lt;/b&gt;&lt;br&gt;deterministic&lt;br&gt;FREE" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="190" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eval2" value="&lt;b&gt;TrajectoryEvaluator&lt;/b&gt;&lt;br&gt;LLM judge&lt;br&gt;semantic" style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="190" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eval3" value="&lt;b&gt;Risk Score&lt;/b&gt;&lt;br&gt;deterministic&lt;br&gt;failures + duplicates" style="rounded=1;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- Results -->
        <mxCell id="r1" value="✅ / ❌" style="rounded=1;fillColor=#2E7D32;fontColor=#FFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="395" y="290" width="70" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="0.85" style="rounded=1;fillColor=#3F51B5;fontColor=#FFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="555" y="290" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="🟢 Low" style="rounded=1;fillColor=#C62828;fontColor=#FFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="710" y="290" width="70" height="30" as="geometry" />
        </mxCell>

        <!-- Decision -->
        <mxCell id="decision" value="&lt;b&gt;Ship it? Investigate? Block?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="350" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="ea" style="rounded=0;" edge="1" parent="1" source="agent" target="t1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb" style="rounded=0;" edge="1" parent="1" source="agent" target="t2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec" style="rounded=0;" edge="1" parent="1" source="t1" target="hook"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed" style="rounded=0;" edge="1" parent="1" source="t2" target="hook"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee" style="rounded=0;strokeWidth=2;" edge="1" parent="1" source="hook" target="traj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef" style="rounded=0;" edge="1" parent="1" source="traj" target="eval1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eg" style="rounded=0;" edge="1" parent="1" source="traj" target="eval2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eh" style="rounded=0;" edge="1" parent="1" source="traj" target="eval3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ei" style="rounded=0;" edge="1" parent="1" source="eval1" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ej" style="rounded=0;" edge="1" parent="1" source="eval2" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ek" style="rounded=0;" edge="1" parent="1" source="eval3" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el" style="rounded=0;" edge="1" parent="1" source="r1" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="em" style="rounded=0;" edge="1" parent="1" source="r2" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="en" style="rounded=0;" edge="1" parent="1" source="r3" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
