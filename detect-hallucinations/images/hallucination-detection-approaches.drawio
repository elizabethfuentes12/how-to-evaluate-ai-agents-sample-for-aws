        </mxCell>

        <mxCell id="re1" style="rounded=0;strokeWidth=1;" edge="1" parent="1" source="a1_box" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re2" style="rounded=0;strokeWidth=1;" edge="1" parent="1" source="a2_box" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re3" style="rounded=0;strokeWidth=1;" edge="1" parent="1" source="a3_box" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re4" style="rounded=0;strokeWidth=1;" edge="1" parent="1" source="a4_box" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- When labels -->
        <mxCell id="w1" value="After execution" style="text;html=1;fontSize=9;fontColor=#888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="550" y="93" width="80" height="20" as="geometry" />
